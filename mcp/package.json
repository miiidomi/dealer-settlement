{
  "name": "dealer-settlement-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --import ./tests/register.mjs tests/*.test.mjs",
    "build": "npm run check && npm test && wrangler deploy --dry-run --outdir dist && node scripts/check-runtime.mjs",
    "deploy": "node scripts/check-config.mjs && wrangler deploy",
    "dev": "wrangler dev --local --local-protocol https --var PUBLIC_BASE_URL:https://localhost:8787"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.26.0",
    "jose": "6.2.12",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "@types/node": "26.0.1",
    "typescript": "6.0.3",
    "wrangler": "4.145.0",
    "miniflare": "5.20260930.0-alpha"
  }
}
